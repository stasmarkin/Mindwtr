{
  "name": "mw",
  "version": "0.1.0",
  "description": "Command-line client for the self-hosted Mindwtr Cloud API",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=25"
  },
  "bin": {
    "mw": "dist/cli.js"
  },
  "files": [
